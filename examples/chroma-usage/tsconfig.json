{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "outDir": "dist",
        "rootDir": ".",
        "typeRoots": [
            "./node_modules/@types",
            "../../node_modules/@types"
        ],
        "types": ["node"]
    },
    "include": ["*.ts"],
    "exclude": ["node_modules", "dist"]
}
